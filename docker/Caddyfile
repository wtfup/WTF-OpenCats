# Production reverse proxy for WTF-OpenCats.
# {$SITE_ADDRESS} is supplied by docker/.env — set it to the public hostname
# (e.g. careers.wtfgyms.com) and Caddy provisions a Let's Encrypt cert
# automatically. Set it to :80 for a plain-HTTP smoke test.

{$SITE_ADDRESS} {
	root * /var/www/public
	encode gzip

	# --- Hard blocks -------------------------------------------------------
	# Candidate uploads (resumes, ID scans) physically live under the docroot
	# because OpenCATS hardcodes relative "attachments/" paths. They must never
	# be fetchable directly -- the only legitimate path is
	# index.php?m=attachments&a=getAttachment, which enforces auth via
	# CandidateAuthorization. The upstream attachments/.htaccess is Apache-only
	# and does nothing here, so this block is the actual control.
	@forbidden path /attachments/* /temp/* /upload/* /db/* /docker/* /test/* /src/* /vendor/* /.git/*
	respond @forbidden 404

	# Installer and diagnostics: unauthenticated info disclosure. Removed from
	# the box at deploy time as well; this is defence in depth.
	@installer path /installtest.php /installwizard.php /rebuild_old_docs.php
	respond @installer 404

	# Config and dotfiles.
	@sensitive path /config.php /composer.json /composer.lock /*.md /.* 
	respond @sensitive 404

	# --- Routing -----------------------------------------------------------
	# Candidates landing on the bare hostname get the public job board.
	redir / /careers/ 302

	# Clean, memorable entry points for staff. Without these the only way in is
	# /index.php?m=login, which nobody can be expected to remember or discover.
	redir /login /index.php?m=login 302
	redir /login/ /index.php?m=login 302
	redir /ats /index.php?m=login 302
	redir /ats/ /index.php?m=login 302

	# NOTE the explicit try_files. The php_fastcgi default is
	#   try_files {path} {path}/index.php index.php
	# and that trailing "index.php" is a catch-all: ANY unknown path (/careers/login,
	# /foo/bar, anything) gets served by the root index.php. The app then renders
	# fine, but the browser's base URL is the fake directory, and OpenCATS emits
	# RELATIVE asset paths ("images/...", "css/..."). Those resolve against the fake
	# directory, every stylesheet and script 404s, and the user sees a completely
	# unstyled page that looks like the product is broken.
	#
	# OpenCATS routes purely on query strings against real .php files, so the
	# catch-all buys nothing. Dropping it makes unknown paths honestly 404.
	php_fastcgi php:9000 {
		try_files {path} {path}/index.php
	}
	file_server

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /var/log/caddy/access.log
	}
}
